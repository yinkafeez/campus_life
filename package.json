{
  "name": "campus-life-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Campus Life API and realtime server — multi-university, MongoDB/Mongoose.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "SET NODE_ENV=development&& node --watch server.js",
    "start": "node server.js",
    "start:prod": "SET NODE_ENV=production&& node server.js",
    "test": "node scripts/test-runner.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:indexes": "node scripts/sync-indexes.js",
    "load:test": "node scripts/load-test.js",
    "seed": "node seeds/seed.js --import",
    "seed:reset": "node seeds/seed.js --reset",
    "university:validate": "node scripts/university-bundle.js validate",
    "university:import": "node scripts/university-bundle.js import",
    "user:role": "node scripts/user-role.js",
    "wardrobe:import": "node scripts/wardrobe-import.js",
    "learning:validate": "node scripts/learning-pack.js validate",
    "learning:import": "node scripts/learning-pack.js import",
    "economy:import": "node scripts/content-pack.js economy",
    "games:import": "node scripts/content-pack.js games",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "e2e:cleanup": "node scripts/e2e-cleanup.js",
    "test:raw": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
