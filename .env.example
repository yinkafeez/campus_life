# Campus Life API — TEMPLATE ONLY. The real values live in backend/.env (never committed).
# Copy this file to .env on a new machine, then replace every REPLACE_ME value.
# Every variable is validated at start-up (src/config/env.js); the server refuses to start
# while a required secret is missing or still a placeholder.

NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent  (default: info, silent in tests)
LOG_LEVEL=info

# Frontend origin(s) allowed to call the API with cookies — comma-separated, no trailing slash
CLIENT_URL=http://localhost:5173
# How many proxies sit in front of the API (0 locally, 1 on Render/Heroku-style hosts)
TRUST_PROXY=0

JSON_BODY_LIMIT=100kb
# 300 requests per 15 minutes per IP across /api
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ─── Auth (REQUIRED) ──────────────────────────────────────────────────────
# Signs the short-lived login access token. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME_with_64_random_hex_characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# lax = frontend and API on the same site (dev proxy, same domain). none = different sites (HTTPS only).
COOKIE_SAMESITE=lax
# login/register attempts per RATE_LIMIT_WINDOW_MS per IP (only FAILED logins count)
AUTH_RATE_LIMIT_MAX=10
# failed logins before an account is locked, and for how long
AUTH_MAX_FAILED_LOGINS=8
AUTH_LOCK_MINUTES=15

# ─── Admin ────────────────────────────────────────────────────────────────
# Operator key for admin tools (sent as X-Admin-Key). Generate like JWT_ACCESS_SECRET, or leave
# EMPTY to switch admin keys off (admin ACCOUNTS — npm run user:role — still work).
ADMIN_API_KEY=REPLACE_ME_with_64_random_hex_characters
# University bundles can be large — only authorised admin requests may send this much
ADMIN_JSON_BODY_LIMIT=2mb
# requests per RATE_LIMIT_WINDOW_MS per IP on /api/v1/admin
ADMIN_RATE_LIMIT_MAX=60

# ─── MongoDB ──────────────────────────────────────────────────────────────
# Local (Windows service / mongod): mongodb://127.0.0.1:27017/campus_life_dev
# Atlas: paste the connection string as Atlas gives it. <db_username> / <db_password>
# (or <USERNAME> / <PASSWORD>) are filled from DB_USERNAME / DB_PASSWORD and URL-encoded for you.
MONGODB_URI=mongodb://127.0.0.1:27017/campus_life_dev
DB_USERNAME=
DB_PASSWORD=
# Database to use when the URI names none (Atlas strings often end in "/?appName=...")
MONGODB_DB_NAME=campus_life
# Public DNS resolvers for the mongodb+srv lookup — set this if you see "querySrv ECONNREFUSED"
# (common on Windows). Comma-separated IPs, e.g. 8.8.8.8,1.1.1.1. Empty = system DNS.
DNS_SERVERS=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Production: attempts before exiting. Development always keeps retrying in the background.
MONGODB_CONNECT_RETRIES=5
MONGODB_RETRY_DELAY_MS=2000
