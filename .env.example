# Campus Life web — copy to .env (or .env.local) and adjust. Never commit real values.
# VITE_* variables are PUBLIC: they are bundled into the browser code. No secrets here.

# API origin, no trailing slash. Leave EMPTY in development to use the Vite proxy below.
# Production example: https://api.campuslife.example
VITE_API_URL=

# Development only (read by vite.config.js, never shipped): where the /api proxy forwards to
DEV_API_TARGET=http://localhost:5000
